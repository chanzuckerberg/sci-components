{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "paths": {
      "@components/src/*": ["./src/*"],
      "@data-viz/src/*": ["../data-viz/src/*"]
    }
  },
  "include": ["./src/**/*", "../../.eslintrc.js"],
  "exclude": [
    "node_modules",
    "**/*.scss",
    "**/*.css",
    /*
     * Documentation code examples. They import the library the way a consumer
     * does (`@czi-sds/components`), which this package's own config cannot
     * resolve, and they are never part of the build. `tsconfig.docs-check.json`
     * at the repo root typechecks them instead.
     */
    "./src/**/__storybook__/docs/examples/**"
  ],
  "references": []
}

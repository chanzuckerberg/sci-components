{
  "ButtonToggleLegacy": {
    "props": {
      "disabled": {
        "description": "If `true`, the component is disabled.",
        "isRequired": false,
        "type": "boolean"
      },
      "icon": {
        "isRequired": true,
        "type": "ReactElement"
      },
      "sdsSize": {
        "isRequired": false,
        "type": "\"small\" | \"large\" | \"medium\""
      },
      "sdsStage": {
        "isRequired": false,
        "type": "\"off\" | \"on\""
      },
      "sdsType": {
        "isRequired": false,
        "type": "\"primary\" | \"secondary\""
      }
    }
  }
}
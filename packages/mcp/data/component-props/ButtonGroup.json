{
  "ButtonGroup": {
    "props": {
      "backgroundAppearance": {
        "defaultValue": "matchBackground",
        "description": "The background appearance of the button group.",
        "isRequired": false,
        "type": "\"matchBackground\" | \"dark\""
      },
      "disabled": {
        "defaultValue": false,
        "description": "If `true`, the component is disabled.",
        "isRequired": false,
        "type": "boolean"
      },
      "orientation": {
        "defaultValue": "horizontal",
        "description": "The component orientation (layout flow direction).",
        "isRequired": false,
        "type": "\"horizontal\" | \"vertical\""
      },
      "size": {
        "defaultValue": "medium",
        "description": "The size of the button group.",
        "isRequired": false,
        "type": "\"small\" | \"large\" | \"medium\""
      },
      "sdsType": {
        "defaultValue": "primary",
        "description": "The type of the button group that determines the color scheme.",
        "isRequired": false,
        "type": "\"primary\" | \"secondary\""
      }
    }
  }
}
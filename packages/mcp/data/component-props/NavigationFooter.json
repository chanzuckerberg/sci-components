        "description": "The logo displayed in the footer. Can be any valid React node such as an image, icon, or SVG.",
        "isRequired": false,
        "type": "ReactNode"
      },
      "logoUrl": {
        "description": "If provided, clicking the logo will navigate to this URL.",
        "isRequired": false,
        "type": "string"
      },
      "navItems": {
        "description": "The prominent links on the top row, next to the logo. They are headings, not body text, and get no dividers.",
        "isRequired": false,
        "type": "NavigationFooterNavItem[]"
      },
      "navLinks": {
        "description": "The smaller links on the bottom row, drawn in one line with dividers between them.",
        "isRequired": false,
        "type": "NavigationFooterNavItem[]"
      },

{
  "NavigationFooter": {
    "props": {
      "backgroundAppearance": {
        "defaultValue": "matchBackground",
        "description": "\"dark\" puts the footer on a dark surface and inverts its text and dividers, in light mode only.",
        "isRequired": false,
        "type": "\"matchBackground\" | \"dark\""
      },
      "images": {
        "description": "An array of images displayed in the footer. Each item includes an image, optional link URL, and component.",
        "isRequired": false,
        "type": "FooterImage[]"
      },

{
  "CellComponent": {
    "props": {
      "horizontalAlign": {
        "defaultValue": "left",
        "description": "Specifies the horizontal alignment of the cell content.",
        "isRequired": false,
        "type": "\"center\" | \"left\" | \"right\""
      },
      "verticalAlign": {
        "defaultValue": "top",
        "description": "Specifies the vertical alignment of the cell content.",
        "isRequired": false,
        "type": "\"center\" | \"bottom\" | \"top\""
      },
      "width": {
        "isRequired": false,
        "type": "string | number"
      }
    }
  }
}
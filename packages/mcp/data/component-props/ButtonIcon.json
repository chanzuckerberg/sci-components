{
  "ButtonIcon": {
    "props": {
      "disabled": {
        "defaultValue": false,
        "description": "If `true`, the component is disabled.",
        "isRequired": false,
        "type": "boolean"
      },
      "icon": {
        "isRequired": true,
        "type": "ReactElement"
      },
      "sdsSize": {
        "isRequired": false,
        "type": "\"small\" | \"large\" | \"medium\""
      },
      "sdsType": {
        "isRequired": false,
        "type": "\"primary\" | \"secondary\" | \"tertiary\""
      }
    }
  }
}
